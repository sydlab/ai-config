#!/bin/sh
# Push feature branches after commit when origin is configured. Never fails the commit.

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$repo_root" || exit 0

branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)" || exit 0

case "$branch" in
  main|master)
    echo "post-commit: not pushing $branch; commit on a feature branch and open a PR"
    exit 0
    ;;
esac

git remote get-url origin >/dev/null 2>&1 || exit 0

if ! git push --quiet origin HEAD 2>/dev/null; then
  echo "post-commit: push of $branch failed; run: git push origin $branch"
fi
exit 0
