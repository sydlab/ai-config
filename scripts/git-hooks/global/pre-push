#!/usr/bin/env bash
# Blocks push if any pushed commit violates message policy.
# Global hooks — source: ai-config scripts/git-hooks/global/ — install: scripts/install-git-hooks.sh

set -euo pipefail

policy="$(dirname "$0")/commit_policy.py"
failed=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] && continue
  if [[ "$remote_sha" =~ ^0+$ ]] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    # New ref, or a remote tip that was never fetched: check commits not on any remote branch
    shas="$(git rev-list --no-merges "$local_sha" --not --remotes)"
  else
    shas="$(git rev-list --no-merges "${remote_sha}..${local_sha}")"
  fi
  for sha in $shas; do
    if ! git log -1 --format=%B "$sha" | python3 "$policy" check -; then
      echo "pre-push: rejected $(git log -1 --oneline "$sha") on $local_ref" >&2
      failed=1
    fi
  done
done

if [[ "$failed" -ne 0 ]]; then
  echo "pre-push: fix the commit message or amend, then push again" >&2
fi
exit "$failed"
